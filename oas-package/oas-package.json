{
  "package": "oas.dev",
  "version": "2.0.0",
  "description": "OAS-project development policy: the oas.review discipline plus a reference workspace profile for developing OAS itself.",
  "compatibility": {
    "oas": ">=0.20.0"
  },
  "capabilities": [
    "capabilities/oas-review"
  ],
  "configTemplates": {
    "default": {
      "path": "config-templates/default/oas-config.yaml",
      "description": "OAS development workspace root",
      "default": true
    }
  },
  "dependencies": [
    "oas.okf@v2.0.0",
    "oas.aweb@v2.0.0",
    "oas.authoring@v2.0.0"
  ]
}
